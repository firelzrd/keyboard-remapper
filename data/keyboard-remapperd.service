[Unit]
Description=Keyboard Remapper keyboard remapping daemon
Documentation=https://github.com/firelzrd/keyboard-remapper
After=systemd-udevd.service

[Service]
Type=simple
ExecStartPre=-/sbin/modprobe uinput
ExecStart=@BINDIR@/keyboard-remapperd
Restart=on-failure
RestartSec=2
RuntimeDirectory=keyboard-remapper
StateDirectory=keyboard-remapper
# the daemon only needs the input devices and uinput
DevicePolicy=closed
DeviceAllow=char-input rw
DeviceAllow=/dev/uinput rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
